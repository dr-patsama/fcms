# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
POSTGRES_DB=fcms_db
POSTGRES_USER=fcms_user
POSTGRES_PASSWORD=CHANGE_ME_long_random
SECRET_KEY=CHANGE_ME_64_hex_chars   # python3 -c "import secrets;print(secrets.token_hex(32))"
SEED_ADMIN_EMAIL=admin@lifeclinic.com
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_DEMO_PASSWORD=Fcms2026!
SEED_MODE=admin          # "all" = also create one demo login per role for testing
CORS_ORIGINS=http://192.168.1.10:8000,http://fcms.local
ORTHANC_USER=orthanc
ORTHANC_PASSWORD=CHANGE_ME

# ── Journey layer: external connections (all optional; unset = "skipped") ──
CLINIC_NAME_EN=LIFE by Dr. Pat
CLINIC_NAME_TH=ไลฟ์ บาย ดอกเตอร์พัฒน์
CLINIC_PHONE=083-432-4664
PORTAL_BASE_URL=https://app.lifebydrpat.com/portal
# LINE Official Account (Messaging API) + LINE Login / LIFF
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LIFF_ID=
# SMS: none | thaibulksms | twilio | generic
SMS_PROVIDER=none
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
# E-mail (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@lifebydrpat.com
# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
