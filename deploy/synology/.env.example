# Google Calendar (service account JSON path inside the container/host)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_PROCEDURES_ID=
# PromptPay (clinic phone number or 13-digit tax id)
PROMPTPAY_ID=
# Cryo policy
CRYO_TERM_MONTHS=12
CRYO_REMINDER_DAYS=60,30,7
CRYO_GRACE_DAYS=30
OTP_DEV_ECHO=false
